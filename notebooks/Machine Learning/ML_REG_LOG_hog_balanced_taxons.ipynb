    "from sklearn.linear_model import SGDClassifier\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"ENTRAÎNEMENT — HOG TAXONS\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "required_vars = [\"X_train_hog_scaled\", \"y_train\"]\n",
    "missing = [v for v in required_vars if v not in globals()]\n",
    "if missing:\n",
    "    raise NameError(\n",
    "        \"Variables manquantes avant entraînement HOG : \"\n",
    "        + \", \".join(missing)\n",
    "        + \". Lance d'abord la cellule de standardisation.\"\n",
    "    )\n",
    "\n",
    "print(\"Modèle choisi : SGDClassifier(loss='hinge')\")\n",
    "print(\"Interprétation : classifieur linéaire de type SVM entraîné par SGD.\")\n",
    "print(\"Remarque : ici, on prend en compte le déséquilibre avec class_weight='balanced'.\")\n",
    "print()\n",
    "\n",
    "print(\"Dimensions d'entraînement :\")\n",
    "print(\"  X_train_hog_scaled :\", X_train_hog_scaled.shape)\n",
    "print(\"  y_train            :\", y_train.shape)\n",
    "print(\"  n_classes          :\", pd.Series(y_train).nunique())\n",
    "\n",
    "clf = SGDClassifier(\n",
    "    loss=\"hinge\",\n",
    "    penalty=\"l2\",\n",
    "    alpha=1e-4,\n",
    "    max_iter=30,\n",
    "    tol=1e-3,\n",
    "    early_stopping=True,\n",
    "    n_iter_no_change=5,\n",
    "    validation_fraction=0.1,\n",
    "    class_weight=\"balanced\",\n",
    "    random_state=RANDOM_STATE,\n",
    "    verbose=1,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "print(\"\\nEntraînement en cours ...\")\n",
    "clf.fit(X_train_hog_scaled, y_train)\n",
    "\n",
    "print(\"\\n✅ Entraînement terminé.\")\n",
    "print(\"Classes apprises par le modèle :\")\n",
    "print(clf.classes_)\n",
    "print(f\"\\nNombre total de classes apprises : {len(clf.classes_)}\")"

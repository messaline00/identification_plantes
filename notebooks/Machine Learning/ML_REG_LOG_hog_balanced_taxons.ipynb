   "source": [
    "def normalize_columns(df):\n",
    "    df.columns = (\n",
    "        df.columns.astype(str)\n",
    "        .str.replace(\"\\ufeff\", \"\", regex=False)\n",
    "        .str.strip()\n",
    "    )\n",
    "    return df\n",
    "\n",
    "\n",
    "def detect_columns(df, task=\"taxons\"):\n",
    "    df = normalize_columns(df)\n",
    "\n",
    "    path_candidates = [\n",
    "        \"target_path\",\n",
    "        \"chemin\",\n",
    "        \"path\",\n",
    "        \"image_path\",\n",
    "        \"filepath\",\n",
    "        \"file_path\",\n",
    "        \"img_path\",\n",
    "        \"original_path\"\n",
    "    ]\n",
    "\n",
    "    label_candidates = [\n",
    "        \"taxon_label\",\n",
    "        \"label\",\n",
    "        \"class\",\n",
    "        \"target\"\n",
    "    ]\n",
    "\n",
    "    path_col = next((c for c in path_candidates if c in df.columns), None)\n",
    "    label_col = next((c for c in label_candidates if c in df.columns), None)\n",
    "\n",
    "    if path_col is None:\n",
    "        raise ValueError(\n",
    "            \"Aucune colonne chemin trouvée. Colonnes disponibles : \"\n",
    "            + str(df.columns.tolist())\n",
    "        )\n",
    "\n",
    "    if label_col is None:\n",
    "        raise ValueError(\n",
    "            \"Aucune colonne label trouvée. Colonnes disponibles : \"\n",
    "            + str(df.columns.tolist())\n",
    "        )\n",
    "\n",
    "    return path_col, label_col\n",
    "\n",
    "\n",
    "def resolve_image_path(raw_path, base_dir):\n",
    "    p = str(raw_path).strip().replace(\"\\\\\", \"/\")\n",
    "    base_dir = Path(base_dir)\n",
    "\n",
    "    if p.startswith(\"/content/TAXONS/\"):\n",
    "        rel = p.replace(\"/content/TAXONS/\", \"\", 1)\n",
    "        return base_dir / \"TAXONS\" / Path(rel)\n",
    "\n",
    "    if p.startswith(\"/content/MALADIES/\"):\n",
    "        rel = p.replace(\"/content/MALADIES/\", \"\", 1)\n",
    "        return base_dir / \"MALADIES\" / Path(rel)\n",
    "\n",
    "    if p.startswith(\"/content/\"):\n",
    "        rel = p.replace(\"/content/\", \"\", 1)\n",
    "        return base_dir / Path(rel)\n",
    "\n",
    "    path_obj = Path(p)\n",
    "\n",
    "    if path_obj.is_absolute() and path_obj.exists():\n",
    "        return path_obj\n",
    "\n",
    "    candidate = base_dir / path_obj\n",
    "    if candidate.exists():\n",
    "        return candidate\n",
    "\n",
    "    candidate2 = base_dir / \"TAXONS\" / path_obj\n",
    "    if candidate2.exists():\n",
    "        return candidate2\n",
    "\n",
    "    return candidate\n",
    "\n",
    "\n",
    "def make_cache_path(split_name):\n",
    "    return CACHE_DIR / (split_name + \"_hog_features.npz\")\n",
    "\n",
    "\n",
    "def extract_hog_vector(gray_img):\n",
    "    feat = hog(\n",
    "        gray_img,\n",
    "        orientations=HOG_ORIENTATIONS,\n",
    "        pixels_per_cell=HOG_PIXELS_PER_CELL,\n",
    "        cells_per_block=HOG_CELLS_PER_BLOCK,\n",
    "        block_norm=HOG_BLOCK_NORM,\n",
    "        transform_sqrt=HOG_TRANSFORM_SQRT,\n",
    "        feature_vector=True\n",
    "    )\n",
    "    return feat.astype(np.float32)\n",
    "\n",
    "\n",
    "def load_hog_features(csv_path, split_name, img_size=96,\n",
    "                      max_images=None, base_dir=None,\n",
    "                      force_recompute=False):\n",
    "    \"\"\"\n",
    "    Charge les images et extrait les features HOG.\n",
    "    Utilise un cache .npz pour accélérer les relances.\n",
    "    \"\"\"\n",
    "    cache_path = make_cache_path(split_name)\n",
    "\n",
    "    if cache_path.exists() and not force_recompute:\n",
    "        print(\"\\n📦 Chargement du cache HOG :\", cache_path.name)\n",
    "        data = np.load(cache_path, allow_pickle=True)\n",
    "        X = data[\"X\"]\n",
    "        y = data[\"y\"]\n",
    "        print(\"✅ Cache chargé :\", X.shape, y.shape)\n",
    "        return X, y\n",
    "\n",
    "    df = pd.read_csv(csv_path, sep=None, engine=\"python\",\n",
    "                     encoding=\"utf-8-sig\")\n",
    "    df = normalize_columns(df)\n",
    "\n",
    "    path_col, label_col = detect_columns(df, task=\"taxons\")\n",
    "\n",
    "    if max_images is not None:\n",
    "        df = df.iloc[:max_images].copy()\n",
    "\n",
    "    X_list = []\n",
    "    y_list = []\n",
    "\n",
    "    n_missing = 0\n",
    "    n_unreadable = 0\n",
    "\n",
    "    print(\"\\nExtraction HOG —\", split_name)\n",
    "    print(\"  path_col  :\", path_col)\n",
    "    print(\"  label_col :\", label_col)\n",
    "    print(\"  n_images  :\", len(df))\n",
    "\n",
    "    for _, row in tqdm(df.iterrows(), total=len(df), desc=split_name):\n",
    "        img_path = resolve_image_path(row[path_col], base_dir)\n",
    "\n",
    "        if not img_path.exists():\n",
    "            n_missing += 1\n",
    "            continue\n",
    "\n",
    "        gray = cv2.imread(str(img_path), cv2.IMREAD_GRAYSCALE)\n",
    "        if gray is None:\n",
    "            n_unreadable += 1\n",
    "            continue\n",
    "\n",
    "        gray = cv2.resize(gray, (img_size, img_size))\n",
    "        feat = extract_hog_vector(gray)\n",
    "\n",
    "        X_list.append(feat)\n",
    "        y_list.append(str(row[label_col]))\n",
    "\n",
    "    if len(X_list) == 0:\n",
    "        raise ValueError(\"Aucune feature HOG extraite pour \" + split_name)\n",
    "\n",
    "    X = np.vstack(X_list).astype(np.float32)\n",
    "    y = np.array(y_list)\n",
    "\n",
    "    np.savez_compressed(cache_path, X=X, y=y)\n",
    "\n",
    "    print(\"✅ Extraction terminée :\", split_name)\n",
    "    print(\"   X shape      :\", X.shape)\n",
    "    print(\"   y shape      :\", y.shape)\n",
    "    print(\"   manquantes   :\", n_missing)\n",
    "    print(\"   illisibles   :\", n_unreadable)\n",
    "    print(\"   cache sauvé  :\", cache_path.name)\n",
    "\n",
    "    return X, y\n",
    "\n",
    "\n",
    "def compute_metrics(y_true, y_pred, split_name):\n",
    "    return {\n",
    "        \"split\": split_name,\n",
    "        \"accuracy\": accuracy_score(y_true, y_pred),\n",
    "        \"precision_macro\": precision_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ),\n",
    "        \"recall_macro\": recall_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ),\n",
    "        \"f1_macro\": f1_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ),\n",
    "        \"f1_weighted\": f1_score(\n",
    "            y_true, y_pred, average=\"weighted\", zero_division=0\n",
    "        )\n",
    "    }\n",
    "\n",
    "\n",
    "print(\"✅ Cellule 2 chargée — version robuste NB05 (HOG TAXONS)\")"
   ]
  },

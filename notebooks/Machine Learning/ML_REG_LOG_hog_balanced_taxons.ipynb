    "from sklearn.preprocessing import StandardScaler\n",
    "import gc\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"STANDARDISATION\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "required_vars = [\"X_train_hog\", \"X_val_hog\", \"X_test_hog\"]\n",
    "missing = [v for v in required_vars if v not in globals()]\n",
    "if missing:\n",
    "    raise NameError(\n",
    "        \"Variables manquantes avant standardisation HOG : \"\n",
    "        + \", \".join(missing)\n",
    "        + \". Lance d'abord la cellule d'extraction des features HOG.\"\n",
    "    )\n",
    "\n",
    "print(\"Shapes avant standardisation :\")\n",
    "print(\"  X_train_hog :\", X_train_hog.shape)\n",
    "print(\"  X_val_hog   :\", X_val_hog.shape)\n",
    "print(\"  X_test_hog  :\", X_test_hog.shape)\n",
    "\n",
    "# IMPORTANT :\n",
    "# Le scaler est ajusté uniquement sur le TRAIN,\n",
    "# puis appliqué aux ensembles validation et test.\n",
    "scaler = StandardScaler()\n",
    "\n",
    "print(\"\\nTrain : fit_transform ...\")\n",
    "X_train_hog_scaled = scaler.fit_transform(X_train_hog).astype(np.float32)\n",
    "del X_train_hog\n",
    "gc.collect()\n",
    "print(\"  X_train_hog_scaled :\", X_train_hog_scaled.shape)\n",
    "\n",
    "print(\"\\nValidation : transform ...\")\n",
    "X_val_hog_scaled = scaler.transform(X_val_hog).astype(np.float32)\n",
    "del X_val_hog\n",
    "gc.collect()\n",
    "print(\"  X_val_hog_scaled   :\", X_val_hog_scaled.shape)\n",
    "\n",
    "print(\"\\nTest : transform ...\")\n",
    "X_test_hog_scaled = scaler.transform(X_test_hog).astype(np.float32)\n",
    "del X_test_hog\n",
    "gc.collect()\n",
    "print(\"  X_test_hog_scaled  :\", X_test_hog_scaled.shape)\n",
    "\n",
    "print(\"\\nContrôle rapide :\")\n",
    "print(\"  mean(train) ≈\", float(X_train_hog_scaled.mean()))\n",
    "print(\"  std(train)  ≈\", float(X_train_hog_scaled.std()))\n",
    "\n",
    "print(\"\\n✅ Standardisation terminée.\")"
   ]

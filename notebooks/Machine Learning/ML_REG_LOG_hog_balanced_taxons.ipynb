    "from pathlib import Path\n",
    "\n",
    "def resolve_image_path_robust(raw_path, base_dir=None):\n",
    "    \"\"\"\n",
    "    Résout un chemin image de façon robuste.\n",
    "\n",
    "    Cas gérés :\n",
    "    1. le chemin du CSV existe déjà tel quel ;\n",
    "    2. le chemin est de type Kaggle et on reconstruit localement ;\n",
    "    3. le chemin est Windows ancien / relatif -> reconstruction via base_dir.\n",
    "\n",
    "    Hypothèse :\n",
    "    - base_dir pointe vers le dossier 'all'\n",
    "    - on reconstruit avec : base_dir / classe / filename\n",
    "    \"\"\"\n",
    "    raw_path = str(raw_path).strip().replace(\"\\\\\", \"/\")\n",
    "\n",
    "    # Cas 1 : le chemin existe déjà tel quel\n",
    "    p = Path(raw_path)\n",
    "    if p.exists():\n",
    "        return p\n",
    "\n",
    "    # Cas 2 : reconstruction à partir des deux derniers morceaux du chemin\n",
    "    if base_dir is not None:\n",
    "        parts = [x for x in raw_path.split(\"/\") if x]\n",
    "        if len(parts) >= 2:\n",
    "            classe = parts[-2]\n",
    "            filename = parts[-1]\n",
    "            rebuilt = Path(base_dir) / classe / filename\n",
    "            return rebuilt\n",
    "\n",
    "    # Fallback\n",
    "    return p"
   ]
  },

    "# =========================================================\n",
    "# PLANTES\n",
    "# 05_machine_learning_amelioration_taxons_hog.ipynb\n",
    "#\n",
    "# Objectif :\n",
    méliorer le baseline TAXONS (NB04) en remplaçant\n",
    "#   les pixels bruts par des descripteurs HOG.\n",
    "#\n",
    "# Choix méthodologiques :\n",
    "#   - images converties en niveaux de gris\n",
    "#   - resize 64×64 (identique à NB04 pour comparaison propre)\n",
    "#   - extraction HOG\n",
    "#   - standardisation\n",
    "#   - classifieur linéaire avec class_weight='balanced'\n",
    "#\n",
    "# Remarque :\n",
    "#   La résolution d'entrée est volontairement identique\n",
    "#   à celle du baseline NB04 (64×64), afin que la seule\n",
    "#   différence entre les deux notebooks soit la représentation\n",
    "#   visuelle (pixels bruts vs HOG).\n",
    "# =========================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "import gc\n",
    "import json\n",
    "\n",
    "from pathlib import Path\n",
    "from tqdm import tqdm\n",
    "from skimage.feature import hog\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.linear_model import SGDClassifier\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score,\n",
    "    classification_report,\n",
    "    confusion_matrix\n",
    ")\n",
    "\n",
    "import joblib\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "pd.set_option(\"display.max_columns\", 200)\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Chemins\n",
    "# ---------------------------------------------------------\n",
    "BASE_DIR   = Path(r\"C:\\Users\\Bronislaw\\DS\\Arena\\TAXONS\\all\")\n",
    "SPLIT_DIR  = BASE_DIR / \"new_splits\" \n",
    "OUT_ROOT   = BASE_DIR / \"new_ml_outputs\"\n",
    "OUT_DIR    = OUT_ROOT / \"taxons_hog\"\n",
    "CACHE_DIR  = OUT_ROOT / \"taxons_hog_cache\"\n",
    "\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "CACHE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "TRAIN_CSV = SPLIT_DIR / \"train.csv\"\n",
    "VAL_CSV   = SPLIT_DIR / \"val.csv\"\n",
    "TEST_CSV  = SPLIT_DIR / \"test.csv\"\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Paramètres\n",
    "# ---------------------------------------------------------\n",
    "RANDOM_STATE = 42\n",
    "IMG_SIZE     = 64          # ← identique à NB04\n",
    "\n",
    "HOG_ORIENTATIONS    = 9\n",
    "HOG_PIXELS_PER_CELL = (16, 16)\n",
    "HOG_CELLS_PER_BLOCK = (2, 2)\n",
    "HOG_BLOCK_NORM      = \"L2-Hys\"\n",
    "HOG_TRANSFORM_SQRT  = True\n",
    "\n",
    "MAX_IMAGES_TRAIN = None\n",
    "MAX_IMAGES_VAL   = None\n",
    "MAX_IMAGES_TEST  = None\n",
    "\n",
    "FORCE_RECOMPUTE = True     # ← important : recalculer le cache HOG\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Calcul théorique du nombre de features HOG\n",
    "# ---------------------------------------------------------\n",
    "n_cells  = IMG_SIZE // HOG_PIXELS_PER_CELL[0]\n",
    "n_blocks = n_cells - HOG_CELLS_PER_BLOCK[0] + 1\n",
    "N_HOG_FEATURES = (\n",
    "    n_blocks * n_blocks\n",
    "    * HOG_CELLS_PER_BLOCK[0] * HOG_CELLS_PER_BLOCK[1]\n",
    "    * HOG_ORIENTATIONS\n",
    ")\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Références pour comparaison (à compléter après NB04)\n",
    "# ---------------------------------------------------------\n",
    "REF_NB04_ACC = 0.3730    # ← à compléter après exécution de NB04\n",
    "REF_NB04_F1M = 0.2638\n",
    "REF_NB04_F1W = 0.3422\n",
    "\n",
    "print(\"✅ Configuration chargée — NB05 (HOG TAXONS)\")\n",
    "print(\"BASE_DIR   :\", BASE_DIR)\n",
    "print(\"SPLIT_DIR  :\", SPLIT_DIR)\n",
    "print(\"OUT_DIR    :\", OUT_DIR)\n",
    "print(\"CACHE_DIR  :\", CACHE_DIR)\n",
    "print()\n",
    "print(\"Fichiers splits TAXONS :\")\n",
    "print(\" -\", TRAIN_CSV, \"| exists =\", TRAIN_CSV.exists())\n",
    "print(\" -\", VAL_CSV,   \"| exists =\", VAL_CSV.exists())\n",
    "print(\" -\", TEST_CSV,  \"| exists =\", TEST_CSV.exists())\n",
    "print()\n",
    "print(\"Paramètres :\")\n",
    "print(\" - IMG_SIZE        :\", IMG_SIZE)\n",
    "print(\" - N_HOG_FEATURES  :\", N_HOG_FEATURES)\n",
    "print(\" - FORCE_RECOMPUTE :\", FORCE_RECOMPUTE)\n",
    "print()\n",
    "print(\"Vérification théorique :\")\n",
    "print(f\"  {IMG_SIZE}×{IMG_SIZE} → {n_cells}×{n_cells} cellules\")\n",
    "print(f\"  → {n_blocks}×{n_blocks} blocs\")\n",
    "print(f\"  → {N_HOG_FEATURES} features HOG\")"
   ]

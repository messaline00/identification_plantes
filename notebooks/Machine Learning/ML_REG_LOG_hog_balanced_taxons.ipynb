   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import cv2\n",
    "from tqdm.auto import tqdm\n",
    "from skimage.feature import hog\n",
    "\n",
    "def load_hog_features(csv_path, split_name, img_size=96,\n",
    "                      max_images=None, base_dir=None,\n",
    "                      force_recompute=False,\n",
    "                      task=\"taxons\", debug_missing=5):\n",
    "    \"\"\"\n",
    "    Charge les images, calcule les descripteurs HOG\n",
    "    et retourne X (features) + y (labels).\n",
    "\n",
    "    Paramètres\n",
    "    ----------\n",
    "    csv_path : str or Path\n",
    "        Chemin vers train.csv / val.csv / test.csv\n",
    "    split_name : str\n",
    "        Nom logique du split\n",
    "    img_size : int\n",
    "        Taille finale de l'image (img_size x img_size)\n",
    "    max_images : int or None\n",
    "        Si défini, limite le nombre d'images\n",
    "    base_dir : str or Path or None\n",
    "        Dossier 'all'\n",
    "    force_recompute : bool\n",
    "        Gardé pour compatibilité ; non utilisé ici\n",
    "    task : str\n",
    "        'taxons' ou 'maladies'\n",
    "    debug_missing : int\n",
    "        Nombre max d'exemples de chemins à afficher\n",
    "    \"\"\"\n",
    "\n",
    "    df = pd.read_csv(csv_path, sep=None, engine=\"python\", encoding=\"utf-8-sig\")\n",
    "    df = normalize_columns(df)\n",
    "\n",
    "    path_col, label_col = detect_columns(df, task=task)\n",
    "\n",
    "    if max_images is not None:\n",
    "        df = df.iloc[:max_images].copy()\n",
    "\n",
    "    n_rows = len(df)\n",
    "\n",
    "    X_list = []\n",
    "    y_list = []\n",
    "\n",
    "    n_ok = 0\n",
    "    n_missing = 0\n",
    "    n_unreadable = 0\n",
    "    n_hog_errors = 0\n",
    "\n",
    "    missing_examples = []\n",
    "    unreadable_examples = []\n",
    "    hog_examples = []\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"EXTRACTION HOG —\", split_name.upper())\n",
    "    print(\"=\" * 60)\n",
    "    print(\"csv_path   :\", csv_path)\n",
    "    print(\"base_dir   :\", base_dir)\n",
    "    print(\"path_col   :\", path_col)\n",
    "    print(\"label_col  :\", label_col)\n",
    "    print(\"n_images   :\", n_rows)\n",
    "    print(\"img_size   :\", img_size)\n",
    "    print(\"HOG params :\")\n",
    "    print(\"  orientations      :\", HOG_ORIENTATIONS)\n",
    "    print(\"  pixels_per_cell   :\", HOG_PIXELS_PER_CELL)\n",
    "    print(\"  cells_per_block   :\", HOG_CELLS_PER_BLOCK)\n",
    "\n",
    "    for _, row in tqdm(df.iterrows(), total=n_rows, desc=split_name):\n",
    "        img_path = resolve_image_path_robust(row[path_col], base_dir)\n",
    "\n",
    "        if not img_path.exists():\n",
    "            n_missing += 1\n",
    "            if len(missing_examples) < debug_missing:\n",
    "                missing_examples.append({\n",
    "                    \"csv_path_value\": str(row[path_col]),\n",
    "                    \"resolved_path\": str(img_path)\n",
    "                })\n",
    "            continue\n",
    "\n",
    "        gray = cv2.imread(str(img_path), cv2.IMREAD_GRAYSCALE)\n",
    "        if gray is None:\n",
    "            n_unreadable += 1\n",
    "            if len(unreadable_examples) < debug_missing:\n",
    "                unreadable_examples.append(str(img_path))\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            gray = cv2.resize(gray, (img_size, img_size))\n",
    "\n",
    "            features = hog(\n",
    "                gray,\n",
    "                orientations=HOG_ORIENTATIONS,\n",
    "                pixels_per_cell=HOG_PIXELS_PER_CELL,\n",
    "                cells_per_block=HOG_CELLS_PER_BLOCK,\n",
    "                block_norm=\"L2-Hys\",\n",
    "                transform_sqrt=True,\n",
    "                feature_vector=True\n",
    "            )\n",
    "\n",
    "            X_list.append(features.astype(np.float32))\n",
    "            y_list.append(str(row[label_col]))\n",
    "            n_ok += 1\n",
    "\n",
    "        except Exception as e:\n",
    "            n_hog_errors += 1\n",
    "            if len(hog_examples) < debug_missing:\n",
    "                hog_examples.append({\n",
    "                    \"img_path\": str(img_path),\n",
    "                    \"error\": repr(e)\n",
    "                })\n",
    "            continue\n",
    "\n",
    "    if len(X_list) == 0:\n",
    "        print(\"\\n❌ Aucune feature HOG extraite pour\", split_name)\n",
    "        print(\"   Vérifie surtout :\")\n",
    "        print(\"   1. que BASE_DIR pointe bien vers le dossier 'all'\")\n",
    "        print(\"   2. que resolve_image_path_robust() est bien défini\")\n",
    "        print(\"   3. que les paramètres HOG sont compatibles avec IMG_SIZE\")\n",
    "        print(\"   4. que les images existent physiquement\")\n",
    "\n",
    "        if missing_examples:\n",
    "            print(\"\\nExemples de chemins introuvables :\")\n",
    "            for ex in missing_examples:\n",
    "                print(\"  - valeur CSV  :\", ex[\"csv_path_value\"])\n",
    "                print(\"    chemin testé:\", ex[\"resolved_path\"])\n",
    "\n",
    "        if unreadable_examples:\n",
    "            print(\"\\nExemples de fichiers illisibles :\")\n",
    "            for ex in unreadable_examples:\n",
    "                print(\"  -\", ex)\n",
    "\n",
    "        if hog_examples:\n",
    "            print(\"\\nExemples d'erreurs HOG :\")\n",
    "            for ex in hog_examples:\n",
    "                print(\"  -\", ex[\"img_path\"])\n",
    "                print(\"    \", ex[\"error\"])\n",
    "\n",
    "        raise ValueError(\"Aucune feature HOG extraite pour \" + split_name)\n",
    "\n",
    "    X = np.vstack(X_list).astype(np.float32)\n",
    "    y = np.array(y_list)\n",
    "\n",
    "    print(\"\\n✅ Extraction HOG terminée :\", split_name)\n",
    "    print(\"   X shape        :\", X.shape)\n",
    "    print(\"   y shape        :\", y.shape)\n",
    "    print(\"   images OK      :\", n_ok)\n",
    "    print(\"   manquantes     :\", n_missing)\n",
    "    print(\"   illisibles     :\", n_unreadable)\n",
    "    print(\"   erreurs HOG    :\", n_hog_errors)\n",
    "\n",
    "    if missing_examples:\n",
    "        print(\"\\nExemples de fichiers manquants :\")\n",
    "        for ex in missing_examples:\n",
    "            print(\"  - valeur CSV  :\", ex[\"csv_path_value\"])\n",
    "            print(\"    chemin testé:\", ex[\"resolved_path\"])\n",
    "\n",
    "    if unreadable_examples:\n",
    "        print(\"\\nExemples de fichiers illisibles :\")\n",
    "        for ex in unreadable_examples:\n",
    "            print(\"  -\", ex)\n",
    "\n",
    "    if hog_examples:\n",
    "        print(\"\\nExemples d'erreurs HOG :\")\n",
    "        for ex in hog_examples:\n",
    "            print(\"  -\", ex[\"img_path\"])\n",
    "            print(\"    \", ex[\"error\"])\n",
    "\n",
    "    return X, y"
   ]
  },

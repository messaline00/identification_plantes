    "print(\"=\" * 60)\n",
    "print(\"VISUALISATION D'UN EXEMPLE HOG\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "from skimage.feature import hog as sk_hog\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import cv2\n",
    "\n",
    "required_vars = [\n",
    "    \"TRAIN_CSV\", \"BASE_DIR\", \"IMG_SIZE\",\n",
    "    \"HOG_ORIENTATIONS\", \"HOG_PIXELS_PER_CELL\", \"HOG_CELLS_PER_BLOCK\"\n",
    "]\n",
    "missing = [v for v in required_vars if v not in globals()]\n",
    "if missing:\n",
    "    raise NameError(\n",
    "        \"Variables manquantes avant visualisation HOG : \"\n",
    "        + \", \".join(missing)\n",
    "    )\n",
    "\n",
    "# Paramètres HOG avec valeurs par défaut si non définies\n",
    "hog_block_norm = globals().get(\"HOG_BLOCK_NORM\", \"L2-Hys\")\n",
    "hog_transform_sqrt = globals().get(\"HOG_TRANSFORM_SQRT\", True)\n",
    "\n",
    "# Lecture d'un exemple\n",
    "df_ex = pd.read_csv(\n",
    "    TRAIN_CSV,\n",
    "    sep=None,\n",
    "    engine=\"python\",\n",
    "    encoding=\"utf-8-sig\",\n",
    "    nrows=1\n",
    ")\n",
    "df_ex = normalize_columns(df_ex)\n",
    "\n",
    "path_col, label_col = detect_columns(df_ex, task=\"taxons\")\n",
    "\n",
    "img_raw = df_ex.iloc[0][path_col]\n",
    "img_path = resolve_image_path_robust(img_raw, BASE_DIR)\n",
    "\n",
    "print(\"Exemple brut    :\", img_raw)\n",
    "print(\"Exemple résolu  :\", img_path)\n",
    "print(\"Exists ?        :\", img_path.exists())\n",
    "\n",
    "if not img_path.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f\"Image introuvable : {img_path}\\n\"\n",
    "        f\"Vérifie BASE_DIR = {BASE_DIR}\"\n",
    "    )\n",
    "\n",
    "gray = cv2.imread(str(img_path), cv2.IMREAD_GRAYSCALE)\n",
    "if gray is None:\n",
    "    raise ValueError(f\"Impossible de lire l'image en grayscale : {img_path}\")\n",
    "\n",
    "gray = cv2.resize(gray, (IMG_SIZE, IMG_SIZE))\n",
    "\n",
    "# Calcul HOG avec visualisation\n",
    "feat, hog_img = sk_hog(\n",
    "    gray,\n",
    "    orientations=HOG_ORIENTATIONS,\n",
    "    pixels_per_cell=HOG_PIXELS_PER_CELL,\n",
    "    cells_per_block=HOG_CELLS_PER_BLOCK,\n",
    "    block_norm=hog_block_norm,\n",
    "    transform_sqrt=hog_transform_sqrt,\n",
    "    feature_vector=True,\n",
    "    visualize=True\n",
    ")\n",
    "\n",
    "# Calcul théorique du nombre attendu de features\n",
    "n_cells_h = IMG_SIZE // HOG_PIXELS_PER_CELL[0]\n",
    "n_cells_w = IMG_SIZE // HOG_PIXELS_PER_CELL[1]\n",
    "n_blocks_h = n_cells_h - HOG_CELLS_PER_BLOCK[0] + 1\n",
    "n_blocks_w = n_cells_w - HOG_CELLS_PER_BLOCK[1] + 1\n",
    "\n",
    "n_hog_expected = (\n",
    "    n_blocks_h * n_blocks_w *\n",
    "    HOG_CELLS_PER_BLOCK[0] * HOG_CELLS_PER_BLOCK[1] *\n",
    "    HOG_ORIENTATIONS\n",
    ")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
    "\n",
    "axes[0].imshow(gray, cmap=\"gray\")\n",
    "axes[0].set_title(f\"Image grayscale ({IMG_SIZE}×{IMG_SIZE})\")\n",
    "axes[0].axis(\"off\")\n",
    "\n",
    "axes[1].imshow(hog_img, cmap=\"gray\")\n",
    "axes[1].set_title(\"Visualisation HOG\")\n",
    "axes[1].axis(\"off\")\n",
    "\n",
    "plt.suptitle(\n",
    "    f\"Exemple HOG — TAXONS (resize {IMG_SIZE}×{IMG_SIZE})\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "plt.tight_layout()\n",
    "\n",
    "# Sauvegarde optionnelle\n",
    "plt.savefig(\"taxons_hog_visualisation_example.png\", dpi=150, bbox_inches=\"tight\")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nParamètres HOG :\")\n",
    "print(\"  orientations      :\", HOG_ORIENTATIONS)\n",
    "print(\"  pixels_per_cell   :\", HOG_PIXELS_PER_CELL)\n",
    "print(\"  cells_per_block   :\", HOG_CELLS_PER_BLOCK)\n",
    "print(\"  block_norm        :\", hog_block_norm)\n",
    "print(\"  transform_sqrt    :\", hog_transform_sqrt)\n",
    "\n",
    "print(\"\\nDimension du vecteur HOG obtenu :\", len(feat))\n",
    "print(\"Dimension attendue              :\", n_hog_expected)\n",
    "\n",
    "if len(feat) == n_hog_expected:\n",
    "    print(\"✅ Le nombre de features HOG est cohérent.\")\n",
    "else:\n",
    "    print(\"⚠️ Le nombre de features HOG ne correspond pas à la théorie.\")\n",
    "\n",
    "print(\"\\n✅ Figure sauvegardée : taxons_hog_visualisation_example.png\")"
